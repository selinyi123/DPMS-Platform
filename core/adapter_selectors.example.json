{
  "__note__": "Starter selector config. Every selector must be verified against the current page with a read-only probe. Bilibili execution requires its API evidence contract. Weibo selectors are observation metadata only: real writes require the official OAuth adapter plus fresh account/action capability evidence and explicit user confirmation. Xiaohongshu and Douyin are manual-assisted only. Douyin favorited/reposted must use separate explicit done-state selectors; a generic share icon is not evidence for either action.",
  "bilibili": {
    "followed": ["button:has-text('关注')", "[class*='follow-btn']:has-text('关注')"],
    "liked": ["[aria-label*='点赞']", "button[class*='like']"],
    "reposted": ["button:has-text('转发')", "button[class*='share']"],
    "commented": {
      "input": ["textarea", "[contenteditable='true'][role='textbox']"],
      "submit": ["button:has-text('发布')"],
      "text": "参与抽奖",
      "done": []
    }
  },
  "weibo": {
    "followed": ["button:has-text('关注')", "[title*='关注']"],
    "liked": ["[title*='赞']", "button[class*='like']"],
    "favorited": ["button:has-text('收藏')", "[title*='收藏']"],
    "reposted": ["button:has-text('转发')", "[title*='转发']"],
    "commented": {
      "input": ["textarea[placeholder*='评论']", "textarea"],
      "submit": ["button:has-text('评论')", "button:has-text('发布')"]
    }
  },
  "douyin": {
    "followed": ["button:has-text('关注')", "[data-e2e='follow-icon']"],
    "liked": ["[data-e2e='like-icon']", "[aria-label*='赞']"],
    "commented": {
      "input": ["[data-e2e='comment-input']", "[contenteditable='true']"],
      "submit": ["button:has-text('发布')"]
    },
    "favorited": {"done": []},
    "reposted": {"done": []}
  },
  "xiaohongshu": {
    "followed": ["button:has-text('关注')"],
    "liked": ["[class*='like-wrapper']", "[aria-label*='点赞']"],
    "commented": {
      "input": ["[contenteditable='true']", "textarea"],
      "submit": ["button:has-text('发送')"]
    },
    "favorited": ["[class*='collect-wrapper']", "[aria-label*='收藏']"]
  }
}
