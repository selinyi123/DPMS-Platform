# Copy to .env.mysql-admin, replace this development-only value, and pass it
# only to Compose interpolation:
# docker compose --env-file .env --env-file .env.mysql-admin \
#   --env-file .env.redis-admin up ...
# Never merge this file into .env. The root credential belongs only to the
# MySQL container and the explicit in-container role-provisioning operation.
MYSQL_ROOT_PASSWORD=rootpass
