# Copy to .env.redis-admin, replace this development-only value, and pass it
# only to Compose interpolation:
# docker compose --env-file .env --env-file .env.mysql-admin \
#   --env-file .env.redis-admin up ...
# Never merge this file into .env. The group-admin credential belongs only to
# Redis bootstrap and explicit, short-lived retirement operations.
REDIS_GROUP_ADMIN_PASSWORD=dpms-group-admin-local-only-change-me-2026
