global:
  scrape_interval: 15s

scrape_configs:
  - job_name: dpms-core
    metrics_path: /api/metrics/prometheus
    static_configs:
      - targets: ["core-api:8000"]
    authorization:
      type: Bearer
      credentials_file: /run/secrets/dpms-prometheus-bearer-token

rule_files:
  - /etc/prometheus/dpms-alerts.yml
