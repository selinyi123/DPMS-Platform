ENCRYPTION_KEY=
# In strict production, each platform lane must use its own 32-byte base64
# key. The shared ENCRYPTION_KEY remains for the control plane only.
ENCRYPTION_KEY_BILIBILI=
ENCRYPTION_KEY_WEIBO=
ENCRYPTION_KEY_XIAOHONGSHU=
ENCRYPTION_KEY_DOUYIN=
UPDATE_SECRET=changeme-local-update-secret
ADMIN_TOKEN=change-me-admin-token
REAL_RUN_ENABLED=false
# Independent strategy dispatcher. The Compose profile and this switch must
# both be enabled; an empty platform list dispatches nothing.
DPMS_AUTOPILOT_ENABLED=false
DPMS_AUTOPILOT_PLATFORMS=
DPMS_AUTOPILOT_ROUND_LIMIT=10
DPMS_AUTOPILOT_SCAN_LIMIT=100
DPMS_AUTOPILOT_FAILURE_LIMIT=3
DPMS_AUTOPILOT_POLL_SECONDS=60
DPMS_AUTOPILOT_REQUEST_TIMEOUT_SECONDS=20
# Required in addition to REAL_RUN_ENABLED=true before Autopilot may request
# real-run. The only accepted value is
# I_ACKNOWLEDGE_DPMS_AUTOPILOT_REAL_RUN; leave blank for dry/shadow only.
DPMS_AUTOPILOT_REAL_RUN_ACK=
# Independent read-only Xiaohongshu target pursuit daemon. Both the switch and
# the explicit platform allowlist are required; this daemon never accepts,
# skips, or executes a candidate.
DPMS_XIAOHONGSHU_TARGET_PURSUIT_ENABLED=false
DPMS_XIAOHONGSHU_TARGET_PURSUIT_PLATFORMS=
DPMS_XIAOHONGSHU_TARGET_PURSUIT_CADENCE_SECONDS=1800
DPMS_XIAOHONGSHU_TARGET_PURSUIT_POLL_SECONDS=60
DPMS_XIAOHONGSHU_TARGET_PURSUIT_SOURCE_LIMIT=100
DPMS_XIAOHONGSHU_TARGET_PURSUIT_SCAN_LIMIT=10
DPMS_XIAOHONGSHU_TARGET_PURSUIT_FAILURE_LIMIT=3
DPMS_XIAOHONGSHU_TARGET_PURSUIT_MAX_CANDIDATES=20
DPMS_XIAOHONGSHU_TARGET_PURSUIT_REQUEST_TIMEOUT_SECONDS=120
LEGACY_TASK_STREAM_DRAIN_ENABLED=true
LEGACY_CONTROL_STREAM_DRAIN_ENABLED=true
REDIS_MAX_CONNECTIONS=64
REDIS_SOCKET_TIMEOUT_SECONDS=15
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_CONSUMER_GROUP_STALE_SECONDS=900
# Compose provisions one shared control pair plus a Core/Worker pair per
# platform. Replace every default before DEPLOYMENT_MODE=production;
# passwords may contain punctuation because applications pass them separately
# from REDIS_URL. Keep the group-admin password only in .env.redis-admin (see
# its example file).
REDIS_CORE_PASSWORD=dpms-core-local-only-change-me-2026
REDIS_WORKER_PASSWORD=dpms-worker-local-only-change-me-2026
REDIS_CORE_BILIBILI_USERNAME=core-bilibili
REDIS_WORKER_BILIBILI_USERNAME=worker-bilibili
REDIS_CORE_BILIBILI_PASSWORD=dpms-core-bilibili-local-only-change-me-2026
REDIS_WORKER_BILIBILI_PASSWORD=dpms-worker-bilibili-local-only-change-me-2026
REDIS_CORE_WEIBO_USERNAME=core-weibo
REDIS_WORKER_WEIBO_USERNAME=worker-weibo
REDIS_CORE_WEIBO_PASSWORD=dpms-core-weibo-local-only-change-me-2026
REDIS_WORKER_WEIBO_PASSWORD=dpms-worker-weibo-local-only-change-me-2026
REDIS_CORE_XIAOHONGSHU_USERNAME=core-xiaohongshu
REDIS_WORKER_XIAOHONGSHU_USERNAME=worker-xiaohongshu
REDIS_CORE_XIAOHONGSHU_PASSWORD=dpms-core-xiaohongshu-local-only-change-me-2026
REDIS_WORKER_XIAOHONGSHU_PASSWORD=dpms-worker-xiaohongshu-local-only-change-me-2026
REDIS_CORE_DOUYIN_USERNAME=core-douyin
REDIS_WORKER_DOUYIN_USERNAME=worker-douyin
REDIS_CORE_DOUYIN_PASSWORD=dpms-core-douyin-local-only-change-me-2026
REDIS_WORKER_DOUYIN_PASSWORD=dpms-worker-douyin-local-only-change-me-2026
REDIS_HEALTH_PASSWORD=dpms-health-local-only-change-me-2026
# Use strict only after every platform database, Redis ACL, and encryption key
# is provisioned. Production refuses platform runners in compat mode.
DPMS_PLATFORM_SECURITY_MODE=compat
DPMS_OUTBOX_ARCHIVE_ENABLED=false
DPMS_OUTBOX_ARCHIVE_RETENTION_SECONDS=2592000
DPMS_OUTBOX_ARCHIVE_BATCH=200
DPMS_OUTBOX_ARCHIVE_INTERVAL_SECONDS=3600
DPMS_PROMETHEUS_ENABLED=false
DEPLOYMENT_MODE=dev
SERVERCHAN_KEY=
FEISHU_WEBHOOK=
GENERIC_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# MySQL role passwords are URL-interpolated and therefore accept only
# A-Z/a-z/0-9 plus . _ ~ - (16-128 chars). Replace every development default
# before production. Keep MYSQL_ROOT_PASSWORD only in .env.mysql-admin (see its
# example file); it is used only by MySQL/bootstrap and is never injected into
# Core, Worker, or core-migrate.
MYSQL_DATABASE=lottery
MYSQL_RUNTIME_USER=dpms_runtime
MYSQL_RUNTIME_PASSWORD=dpms-runtime-local-only-change-me-2026
MYSQL_RUNTIME_USER_BILIBILI=dpms_runtime_bilibili
MYSQL_RUNTIME_PASSWORD_BILIBILI=dpms-runtime-bilibili-local-only-change-me-2026
MYSQL_RUNTIME_USER_WEIBO=dpms_runtime_weibo
MYSQL_RUNTIME_PASSWORD_WEIBO=dpms-runtime-weibo-local-only-change-me-2026
MYSQL_RUNTIME_USER_XIAOHONGSHU=dpms_runtime_xiaohongshu
MYSQL_RUNTIME_PASSWORD_XIAOHONGSHU=dpms-runtime-xiaohongshu-local-only-change-me-2026
MYSQL_RUNTIME_USER_DOUYIN=dpms_runtime_douyin
MYSQL_RUNTIME_PASSWORD_DOUYIN=dpms-runtime-douyin-local-only-change-me-2026
# Leave these blank for shared development/rolling-upgrade mode. In production
# isolated mode, set four distinct names (for example lottery_bilibili, ...).
MYSQL_DATABASE_BILIBILI=
MYSQL_DATABASE_WEIBO=
MYSQL_DATABASE_XIAOHONGSHU=
MYSQL_DATABASE_DOUYIN=
# Shared is for local development/rolling-upgrade compatibility. Production is
# blocked until the platform-aware API database router is delivered; setting
# isolated schemas alone would strand API-created work.
DPMS_MYSQL_PLATFORM_DATABASE_MODE=shared
MYSQL_MIGRATION_USER=dpms_migrate
MYSQL_MIGRATION_PASSWORD=dpms-migrate-local-only-change-me-2026
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
DPMS_HTTP_PORT=8080
CORE_API_PORT=8000
DPMS_VERSION=
VITE_API_BASE=/api
VITE_API_TIMEOUT_MS=15000
VITE_DPMS_VERSION=
WORKER_MAX_BROWSERS=1
WORKER_PERSISTENT_CONTEXT_TTL_SECONDS=3600
WORKER_PERSISTENT_CONTEXT_IDLE_SECONDS=900
WORKER_MAX_PERSISTENT_CONTEXTS=4
WORKER_CONTEXT_REAPER_INTERVAL_SECONDS=60
DPMS_ADAPTER_SELECTORS={}
DPMS_ADAPTER_SELECTORS_B64=
# Windows-host Douyin device agent. Generate one random token of 32-512 bytes
# and set the identical value in DPMS_DEVICE_AGENT_BEARER_TOKEN for the host
# process. Keep the Docker-side URL on host.docker.internal.
DOUYIN_DEVICE_AGENT_URL=http://host.docker.internal:8765
DOUYIN_DEVICE_AGENT_TOKEN=
DOUYIN_DEVICE_AGENT_TIMEOUT_SECONDS=45
# Public egress IP sent to Weibo OAuth mutation endpoints that require `rip`.
# Required for loopback/private Compose ingress unless a trusted proxy below
# supplies X-Real-IP. It must be a single globally routable IPv4/IPv6 address.
WEIBO_PUBLIC_RIP=
# Comma-separated proxy CIDRs allowed to overwrite X-Real-IP for Weibo RIP.
# Default Nginx runs on a Docker bridge, so use its actual app-net CIDR only
# when Core cannot be reached around Nginx. Do not copy a broad private CIDR.
WEIBO_TRUSTED_PROXY_CIDRS=
